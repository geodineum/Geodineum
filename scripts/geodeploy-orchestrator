#!/bin/bash
# =============================================================================
# Geodineum Deploy Orchestrator
# =============================================================================
# Cron script that pulls all ecosystem repos and runs the per-repo deploy
# hooks defined in their geodeploy.yaml descriptors (logic in lib/geodeploy.sh).
#
# Crontab:
#   */5 * * * * /opt/geodineum/Geodineum/scripts/geodeploy-orchestrator
#
# Log: /var/log/geodineum/deploy/auto-deploy.log (deploy_user:geodineum, capped at 2000 lines)
# =============================================================================

set -uo pipefail

# The deploy log and run artifacts must not be world-readable.
umask 027

# Cron has a minimal PATH
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GEODINEUM_REPO="$(dirname "$SCRIPT_DIR")"

# The lib turns on set -e; if sourcing it fails, record that in the log.
if ! source "${GEODINEUM_REPO}/lib/geodeploy.sh"; then
    mkdir -p /var/log/geodineum/deploy 2>/dev/null || true
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ORCHESTRATOR: lib source FAILED — run aborted before any deploy" \
        >> /var/log/geodineum/deploy/auto-deploy.log 2>/dev/null || true
    exit 1
fi

# Deploy-user-owned: git runs as the deploy user and appends to the log.
GEODEPLOY_LOG_DIR="$(dirname "$GEODEPLOY_LOG")"
sudo mkdir -p "$GEODEPLOY_LOG_DIR" 2>/dev/null || true
sudo chown "${GEODEPLOY_DEPLOY_USER}:geodineum" "$GEODEPLOY_LOG_DIR" 2>/dev/null || true
sudo chmod 2750 "$GEODEPLOY_LOG_DIR" 2>/dev/null || true

# Single instance: a slow cycle (cargo build) must not overlap the next cron run.
exec 9>"${GEODEPLOY_LOG_DIR}/.orchestrator.lock"
if ! flock -n 9; then
    exit 0
fi

# Log where an abort happened; -E makes the ERR trap fire inside functions.
set -E
trap 'geodeploy_log "ORCHESTRATOR: aborted at line ${LINENO} (cmd: ${BASH_COMMAND})"' ERR

# =============================================================================
# Self-update: pull the Geodineum repo FIRST
# =============================================================================
# Changes pulled here take effect on the next cron run.
geodeploy_set_defaults "bash"
_GD_DIRTY="stash"
# A cycle with any failed repo does not stamp .last-success.
_GD_FAILED_REPOS=()
# One failing repo must not abort the cycle (`||` also suspends set -e).
geodeploy_repo "Geodineum" "main" || { _GD_FAILED_REPOS+=("Geodineum"); geodeploy_log "Geodineum: deploy FAILED (continuing)"; }

# Re-install /usr/local/lib/geodineum helpers (sourced by the CLI and gNode's build).
geodeploy_ensure_helper_libs || geodeploy_log "ensure_helper_libs: FAILED (continuing)"

# =============================================================================
# Core ecosystem repos
# =============================================================================
# name|branch; remotes come from each repo's .git/config

CORE_REPOS=(
    "gNode|main"
    "gNode-Client|main"
    "Geodineum-COMMS|main"
    "gCore|main"
    "gTemplate|main"
    "gCube|main"
    "gMath|main"
)

# =============================================================================
# Deploy cycle
# =============================================================================

for entry in "${CORE_REPOS[@]}"; do
    IFS='|' read -r name branch <<< "$entry"
    geodeploy_repo "$name" "$branch" || { _GD_FAILED_REPOS+=("$name"); geodeploy_log "${name}: deploy FAILED (continuing)"; }
done

# No-op on a host without a pro/ directory.
geodeploy_deploy_pro || { _GD_FAILED_REPOS+=("pro"); geodeploy_log "pro: deploy FAILED (continuing)"; }

# =============================================================================
# Site-local repos (opt-in, never shipped)
# =============================================================================
# "name|branch" per line; an entry deploys only if already cloned under GEODINEUM_ROOT.
SITE_REPOS_FILE="${GEODINEUM_ROOT}/site-repos.conf"
if [[ -f "$SITE_REPOS_FILE" && ! -r "$SITE_REPOS_FILE" ]]; then
    geodeploy_log "ERROR: ${SITE_REPOS_FILE} exists but is NOT readable by the deploy user — site repos are NOT deploying (fix: chown root:geodineum + chmod 640)"
fi
if [[ -r "$SITE_REPOS_FILE" ]]; then
    while IFS='|' read -r _sr_name _sr_branch || [[ -n "$_sr_name" ]]; do
        _sr_name="${_sr_name%%#*}"
        _sr_name="${_sr_name//[[:space:]]/}"
        _sr_branch="${_sr_branch//[[:space:]]/}"
        if [[ -z "$_sr_name" ]]; then continue; fi
        if [[ ! -d "${GEODINEUM_ROOT}/${_sr_name}/.git" ]]; then
            geodeploy_log "${_sr_name}: site-repo listed but not cloned — skipped"
            continue
        fi
        geodeploy_repo "$_sr_name" "${_sr_branch:-main}" || { _GD_FAILED_REPOS+=("$_sr_name"); geodeploy_log "${_sr_name}: deploy FAILED (continuing)"; }
    done < "$SITE_REPOS_FILE"
fi

# Before the perm pass, so the geodineum-dash group exists for fix_config_perms.
geodeploy_ensure_dash_members || geodeploy_log "ensure_dash_members: FAILED (continuing)"

geodeploy_fix_config_perms "/etc/geodineum" || geodeploy_log "fix_config_perms: FAILED (continuing)"
geodeploy_fix_all_credentials "/etc/geodineum/credentials" || geodeploy_log "fix_all_credentials: FAILED (continuing)"

# Geodineum-BAK is not a CORE_REPO, so nothing else sweeps it.
geodeploy_fix_bak_perms "${GEODINEUM_ROOT}/Geodineum-BAK" || geodeploy_log "fix_bak_perms: FAILED (continuing)"

# The COMMS signing key lives in /var/lib, outside the /etc/geodineum sweep.
geodeploy_fix_comms_signing_key || geodeploy_log "fix_comms_signing_key: FAILED (continuing)"

# A perm fixup refused by sudoers logs a warning and never aborts the cycle.
sudo chown root:geodineum "${GEODINEUM_ROOT}" 2>/dev/null \
    || geodeploy_log "WARNING: chown root:geodineum ${GEODINEUM_ROOT} refused (sudoers) — continuing"
sudo chmod 751 "${GEODINEUM_ROOT}" 2>/dev/null \
    || geodeploy_log "WARNING: chmod 751 ${GEODINEUM_ROOT} refused (sudoers rule still 750?) — continuing"  # 751: www-data needs o+x traverse to reach theme symlinks

# www-data traverses gNode to reach credentials via the .gnode symlink.
sudo chmod 751 "${GEODINEUM_ROOT}/gNode" 2>/dev/null \
    || geodeploy_log "WARNING: chmod 751 ${GEODINEUM_ROOT}/gNode refused (sudoers rule still 750?) — continuing"

geodeploy_fix_log_perms "/var/log/geodineum" || geodeploy_log "fix_log_perms: FAILED (continuing)"

geodeploy_harden_all_wp "/var/www" || geodeploy_log "harden_all_wp: FAILED (continuing)"

geodeploy_verify_web_readable "${GEODINEUM_ROOT}" || true
geodeploy_assert_git_guards

# =============================================================================
# Orchestration coverage — nothing rots unseen
# =============================================================================
# Once a day, log every repo that is neither managed nor declared unmanaged.
_gd_today=$(date '+%Y-%m-%d')
_gd_cov_stamp="${GEODEPLOY_LOG_DIR}/.coverage-day"
if [[ "$(cat "$_gd_cov_stamp" 2>/dev/null)" != "$_gd_today" ]]; then
    echo "$_gd_today" > "$_gd_cov_stamp" 2>/dev/null || true

    # Newline-delimited so "gNode" never matches "gNode-Client".
    _gd_managed=$'\n''Geodineum'$'\n'
    for entry in "${CORE_REPOS[@]}"; do
        _gd_managed+="${entry%%|*}"$'\n'
    done
    if [[ -r "$SITE_REPOS_FILE" ]]; then
        while IFS='|' read -r _sr_name _sr_rest || [[ -n "$_sr_name" ]]; do
            _sr_name="${_sr_name%%#*}"
            _sr_name="${_sr_name//[[:space:]]/}"
            if [[ -n "$_sr_name" ]]; then _gd_managed+="${_sr_name}"$'\n'; fi
        done < "$SITE_REPOS_FILE"
    fi

    _gd_unmanaged=$'\n'
    _GD_UNMANAGED_FILE="${GEODINEUM_ROOT}/unmanaged-repos.conf"
    if [[ -r "$_GD_UNMANAGED_FILE" ]]; then
        while IFS= read -r _um_name || [[ -n "$_um_name" ]]; do
            _um_name="${_um_name%%#*}"
            _um_name="${_um_name//[[:space:]]/}"
            if [[ -n "$_um_name" ]]; then _gd_unmanaged+="${_um_name}"$'\n'; fi
        done < "$_GD_UNMANAGED_FILE"
    fi

    for _gd_repo_dir in "${GEODINEUM_ROOT}"/*/; do
        [[ -d "${_gd_repo_dir}.git" ]] || continue
        _gd_repo="$(basename "$_gd_repo_dir")"
        if [[ "$_gd_managed" == *$'\n'"${_gd_repo}"$'\n'* ]]; then continue; fi
        if [[ "$_gd_unmanaged" == *$'\n'"${_gd_repo}"$'\n'* ]]; then
            geodeploy_report_unmanaged_behind "$_gd_repo_dir"; continue
        fi
        if grep -qE '^[[:space:]]*unmanaged:[[:space:]]*true[[:space:]]*$' \
                "${_gd_repo_dir}geodeploy.yaml" 2>/dev/null; then
            geodeploy_report_unmanaged_behind "$_gd_repo_dir"; continue
        fi
        _gd_cov_head=$(geodeploy_as_deploy git -C "$_gd_repo_dir" log -1 --format='%h %cr' 2>/dev/null) || _gd_cov_head=""
        geodeploy_log "COVERAGE WARNING: ${_gd_repo} is in neither CORE_REPOS nor site-repos.conf and is not declared unmanaged — nothing pulls it and nothing fixes its binaries (HEAD ${_gd_cov_head:-unreadable}). Add it to ${SITE_REPOS_FILE} to deploy it, or add its name to ${_GD_UNMANAGED_FILE} (or 'unmanaged: true' in ${_gd_repo}/geodeploy.yaml) to declare it deliberate."
    done
fi

if (( ${_GD_PERM_FIXES:-0} > 0 )); then
    geodeploy_log "PERMS: ${_GD_PERM_FIXES} path(s) corrected this cycle — e.g. ${_GD_PERM_SAMPLE:-(unsampled)}"
fi

# Liveness stamp, withheld on any failure: check with stat -c %y .last-success
if (( ${#_GD_FAILED_REPOS[@]} )); then
    geodeploy_log "ORCHESTRATOR: ERROR ${#_GD_FAILED_REPOS[@]} repo(s) failed this cycle (${_GD_FAILED_REPOS[*]}) — .last-success WITHHELD"
else
    date '+%Y-%m-%d %H:%M:%S' > "${GEODEPLOY_LOG_DIR}/.last-success" 2>/dev/null || true
fi

# Not root-owned: git commands run as the deploy user append to the log.
sudo chown "${GEODEPLOY_DEPLOY_USER}:geodineum" \
                     "$GEODEPLOY_LOG" \
                     "${GEODEPLOY_LOG_DIR}/.last-success" \
                     "${GEODEPLOY_LOG_DIR}/.orchestrator.lock" 2>/dev/null || true
